# Frontend demo configuration
# STOPIFY runs entirely in the browser by default using LocalStorage.
VITE_DATA_MODE=local

# Optional: switch the workspace adapter to the separate backend.
# Set VITE_DATA_MODE=http, provide the API origin, and implement the endpoints in
# docs/BACKEND_INTEGRATION.md. Demo auth stays local until /api/auth/* exists.
VITE_API_BASE_URL=http://localhost:8787
